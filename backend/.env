# Optional: GitHub Personal Access Token
# Providing a token increases the GitHub API rate limit from 60 to 5,000 requests/hour
# and enables scanning private repositories if given repo permissions.
# Format: ghp_... or github_pat_...
GITHUB_TOKEN=

# Request timeout in seconds for GitHub API calls
REQUEST_TIMEOUT_SECONDS=15
